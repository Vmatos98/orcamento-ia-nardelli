# ==============================================================
# Nardelli Usinagem — Exemplo de Variáveis de Ambiente (VPS / Prod)
# Copie este arquivo para .env no servidor e configure suas chaves
# ==============================================================

# Chave de API da OpenRouter (para JEV System One & Claude 3.5 Sonnet)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Porta externa do servidor/host (Ex: 3213)
PORT=3005
HOST_PORT=3213

# Segredo para autenticação JWT
JWT_SECRET=nardelli_usinagem_super_secret_jwt_key_2026

# Modelo de Aprendizagem Ativo (Active Learning JEV)
# true: IA consulta orçamentos históricos validados por humanos para calibrar propostas
# false: IA calcula de forma autônoma a partir do catálogo, sem consultar histórico
USAR_MODELO_APRENDIZAGEM=true

# ==============================================================
# Configurações do Banco PostgreSQL (Container "postgres")
# No Docker Compose, o host de conexão entre contêineres é "postgres"
# ==============================================================
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=nardelli_pg_pass_2026
PG_DATABASE=nardelli
