# ==============================================================
# Nardelli Usinagem — Exemplo de Variáveis de Ambiente (VPS / Prod)
# Copie este arquivo para .env no servidor e configure suas chaves
# ==============================================================

# Chave de API da OpenRouter (para JEV System One & Claude 3.5 Sonnet)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Porta Externa da Aplicação no Host/VPS (Porta não convencional para evitar conflitos)
# Acesse no navegador: http://IP_DA_VPS:3842
HOST_PORT=3842
PORT=3005

# Segredo para autenticação JWT
JWT_SECRET=nardelli_usinagem_super_secret_jwt_key_2026

# Modelo de Aprendizagem Ativo (Active Learning JEV)
# true: IA consulta orçamentos históricos validados por humanos para calibrar propostas
# false: IA calcula de forma autônoma a partir do catálogo, sem consultar histórico
USAR_MODELO_APRENDIZAGEM=true
# Modelo econômico usado para comparar a 1ª versão da IA com o orçamento aprovado e gerar resumo de lições aprendidas
MODELO_ANALISE_APRENDIZADO=google/gemini-2.5-flash

# ==============================================================
# Configurações do Banco PostgreSQL (Container "postgres")
# ==============================================================
# No Docker Compose, a comunicação interna entre contêineres usa o host "postgres" e porta 5432
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=nardelli_pg_pass_2026
PG_DATABASE=nardelli

# Porta externa não convencional exposta no localhost para túnel SSH/DBeaver (evita conflito com 5432)
PG_HOST_PORT=15432

# ==============================================================
# WhatsApp Business Cloud API Oficial (Meta) & Chatbot IA (JEV)
# Webhook URL para cadastrar no Meta Developers: https://SEU_DOMINIO/api/webhook/meta
# ==============================================================
META_VERIFY_TOKEN=nardelli_meta_verify_2026
META_ACCESS_TOKEN=seu_access_token_permanente_meta_aqui
META_PHONE_NUMBER_ID=seu_phone_number_id_meta_aqui
META_APP_SECRET=seu_app_secret_meta_aqui
META_API_VERSION=v24.0
META_APP_ID=seu_meta_app_id_aqui
META_CONFIG_ID=seu_embedded_signup_config_id_aqui

# Chave da Groq para transcrição de áudios e vídeos (Whisper Large v3)
GROQ_API_KEY=sua_chave_groq_aqui

# Janela de agrupamento (debounce) de mensagens sequenciais do cliente em milissegundos
CHATBOT_DEBOUNCE_MS=6000

# ==============================================================
# Automatas Tech Provider Hub (Modo recomendado para múltiplos projetos)
# ==============================================================
AUTOMATAS_HUB_URL=https://api.automatas.tech
AUTOMATAS_SITE_URL=https://automatas.tech
AUTOMATAS_LOGIN_JWT=
AUTOMATAS_PROJECT_API_KEY=
AUTOMATAS_WEBHOOK_URL=
AUTOMATAS_WEBHOOK_SECRET=
