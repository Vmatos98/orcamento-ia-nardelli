# ==============================================================
# Nardelli Usinagem — Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha suas configurações
# ==============================================================

# Chave de API da OpenRouter (para JEV System One & Claude 3.5 Sonnet)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Porta externa do servidor/host (Ex: 3213)
PORT=3213
HOST_PORT=3213

# Segredo para autenticação JWT
JWT_SECRET=nardelli_usinagem_super_secret_jwt_key_2026

# Configurações do Banco PostgreSQL (Opcional - se vazio, utiliza data/database.json)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nardelli
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=nardelli
